# Credentials for Claude Code's native OpenTelemetry export to Langfuse.
# Read by .claude/otel-headers.sh - copy this to .claude/otel.env (gitignored)
# and fill in real values. Without this file, telemetry stays configured but
# silently unauthenticated (Langfuse rejects the export) - Claude Code itself
# is completely unaffected either way.
#
# Same keys as application/issue-tracker/mcp-issue-tracker/mcp/.env and
# agent-pipeline/telemetry/.env - reuse the same Langfuse project's keys, or
# use a different project if you'd rather keep this traffic separate.

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
