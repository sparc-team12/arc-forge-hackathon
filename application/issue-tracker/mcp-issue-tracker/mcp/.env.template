# Backend API the MCP tools call
API_BASE_URL=http://localhost:3000/api

# --- Langfuse tracing ---------------------------------------------------
# Create a project at https://cloud.langfuse.com (free) and copy the key pair
# from Settings -> API Keys. Tracing stays disabled if these are unset, so the
# server still runs normally without them.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# EU cloud: https://cloud.langfuse.com
# US cloud: https://us.cloud.langfuse.com
# Self-hosted: your own URL
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Separates dev/staging/prod traces in the Langfuse UI.
LANGFUSE_TRACING_ENVIRONMENT=development

# Version stamped onto every trace; defaults to the MCP server version.
# LANGFUSE_RELEASE=1.0.0

# SDK diagnostics. DEBUG is verbose; all output goes to stderr.
# LANGFUSE_LOG_LEVEL=WARN
